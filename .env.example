# ── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# After fine-tuning, swap this to your fine-tuned model ID:
# OPENAI_CHAT_MODEL=ft:gpt-4o-mini-2024-07-18:org:unified-rag:abc123

# ── Vector DB ────────────────────────────────────────────────
VECTOR_DB=chroma                     # chroma | pinecone
CHROMA_PERSIST_DIR=./data/chroma_db
PINECONE_API_KEY=
PINECONE_INDEX_NAME=unified-rag

# ── Neo4j Knowledge Graph ─────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# ── Re-ranking ────────────────────────────────────────────────
COHERE_API_KEY=                      # optional — falls back to CrossEncoder
RERANKER_BACKEND=cross_encoder       # cross_encoder | cohere | none
# English-only defaults. For Thai/multilingual docs use:
#   CROSS_ENCODER_MODEL=BAAI/bge-reranker-v2-m3
#   COHERE_RERANK_MODEL=rerank-multilingual-v3.0
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
COHERE_RERANK_MODEL=rerank-english-v3.0

# ── Memory ───────────────────────────────────────────────────
DEFAULT_MEMORY_STRATEGY=buffer       # buffer | summary | vector
BUFFER_WINDOW_SIZE=10
SUMMARY_MAX_TOKENS=2000
MAX_SESSIONS=1000                    # least-recently-used sessions evicted beyond this
SESSION_TTL_MINUTES=120              # idle sessions evicted after this

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production   # clients send it as the X-API-Key header
CORS_ORIGINS=["http://localhost:3000"]   # JSON list of allowed browser origins
API_FILE_ROOT=./data                     # API file paths must be inside this folder
ALLOW_PRIVATE_URLS=false                 # true = /ingest may fetch localhost/private-IP URLs
MAX_KG_DEPTH=4

# ── Observability (optional) ──────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=unified-rag

